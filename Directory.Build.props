<Project>
  <!-- Strong naming for the two signed assemblies. The library and the test project must
       share one key: the library grants the test project access to its internals through
       InternalsVisibleTo, and a friend reference on a signed assembly only resolves when
       the named assembly carries exactly the public key spelled out in the attribute.

       SecretSharingDotNet.Demo.Console is deliberately excluded. It ships unsigned today,
       and inheriting SignAssembly here would silently change its assembly identity. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'SecretSharingDotNet' Or '$(MSBuildProjectName)' == 'SecretSharingDotNetTest'">
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)src/SecretSharingDotNet.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <!-- Public key of src/SecretSharingDotNet.snk, consumed by the InternalsVisibleTo item in
       src/SecretSharingDotNet.csproj. The full 160-byte key (320 hex characters), not the
       8-byte public key token - a friend reference needs the whole key. Written without the
       'PublicKey=' prefix; the SDK prepends it when it emits the attribute.

       The release build signs with the publisher key instead of this repository key, so the
       InternalsVisibleTo entry has to name the publisher's public key or the test project
       stops compiling against the library. .github/workflows/publishing.yml therefore sets
       SecretSharingDotNetPublicKey as an environment variable, which MSBuild picks up as a
       global property; the condition below keeps that override intact and only supplies the
       repository key when nothing else set it. -->
  <PropertyGroup>
    <SecretSharingDotNetPublicKey Condition="'$(SecretSharingDotNetPublicKey)' == ''"></SecretSharingDotNetPublicKey>
  </PropertyGroup>

</Project>
